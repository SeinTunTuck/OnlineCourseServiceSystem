# Copy to .env.local for local development. Never commit the real file.
MONGODB_URI=mongodb+srv://database-user:database-password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=course_management
JWT_SECRET=replace-with-a-long-random-secret
# Exact deployed React frontend origin, without a trailing slash.
FRONTEND_URL=https://your-frontend.vercel.app
